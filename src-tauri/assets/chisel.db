-- Quill
CREATE TABLE IF NOT EXISTS Worlds (
    ID TEXT PRIMARY KEY,
    Name TEXT NOT NULL,
    Description TEXT,
    Genre TEXT,
    CreatedOn TEXT NOT NULL,
    UpdatedOn TEXT NOT NULL,
    CreatedBy TEXT NOT NULL,
);

CREATE TABLE IF NOT EXISTS WO_Buildings (
    ID TEXT PRIMARY KEY,
    WorldId TEXT NOT NULL REFERENCES Worlds(ID) ON DELETE CASCADE,
    Name TEXT NOT NULL,
    Description TEXT,
    CreatedOn TEXT NOT NULL,
    UpdatedOn TEXT NOT NULL,
    CreatedBy TEXT NOT NULL,
);

CREATE TABLE IF NOT EXISTS WO_CelestialBodies (
    ID TEXT PRIMARY KEY,
    WorldId TEXT NOT NULL REFERENCES Worlds(ID) ON DELETE CASCADE,
    Name TEXT NOT NULL,
    Description TEXT,
    CreatedOn TEXT NOT NULL,
    UpdatedOn TEXT NOT NULL,
    CreatedBy TEXT NOT NULL,
);

